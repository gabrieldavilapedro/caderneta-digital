# Copie este arquivo para ".env" e ajuste os valores.
# O mesmo arquivo é lido pelo Django (settings.py) e pelo Docker Compose.

# --- Django ---
# Gere uma chave com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=troque-esta-chave
# True durante o desenvolvimento; False no uso diário pelo comerciante.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (container do docker-compose.yml) ---
POSTGRES_DB=caderneta
POSTGRES_USER=caderneta
# A senha só é aplicada na PRIMEIRA criação do volume do banco.
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=127.0.0.1
# 5433 evita conflito com um PostgreSQL já instalado na máquina (porta 5432).
POSTGRES_PORT=5433
